{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-as-code.dev/schemas/positions.schema.json",
  "title": "Positions",
  "description": "Employment history positions that work units reference for grouping achievements by employer",
  "type": "object",
  "required": ["schema_version", "positions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version for backward compatibility"
    },
    "positions": {
      "type": "object",
      "description": "Map of position ID to position data",
      "additionalProperties": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "description": "Employment position record",
      "required": ["employer", "title", "start_date"],
      "properties": {
        "employer": {
          "type": "string",
          "minLength": 1,
          "description": "Company or organization name"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Job title"
        },
        "location": {
          "type": "string",
          "description": "Location (city, state/country)"
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "Start date in YYYY-MM format"
        },
        "end_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "End date in YYYY-MM format, null for current position"
        },
        "employment_type": {
          "type": "string",
          "enum": ["full-time", "part-time", "contract", "consulting", "freelance"],
          "description": "Type of employment"
        },
        "promoted_from": {
          "type": "string",
          "description": "ID of previous position for promotion tracking"
        },
        "description": {
          "type": "string",
          "description": "Optional role summary"
        },
        "scope": {
          "$ref": "#/$defs/positionScope",
          "description": "Scope indicators for executive positions"
        }
      }
    },
    "positionScope": {
      "type": "object",
      "description": "Leadership scope indicators for executive positions",
      "properties": {
        "revenue": {
          "type": "string",
          "description": "Revenue impact (e.g., '$500M')"
        },
        "team_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Total team size"
        },
        "direct_reports": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of direct reports"
        },
        "budget": {
          "type": "string",
          "description": "Budget managed (e.g., '$50M')"
        },
        "pl_responsibility": {
          "type": "string",
          "description": "P&L responsibility amount (e.g., '$100M')"
        },
        "geography": {
          "type": "string",
          "description": "Geographic reach (e.g., 'Global', 'EMEA', '15 countries')"
        },
        "customers": {
          "type": "string",
          "description": "Customer scope (e.g., '500K users', 'Fortune 500')"
        }
      }
    }
  }
}
