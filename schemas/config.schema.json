          "default": null,
          "title": "Issuer"
        },
        "date": {
          "anyOf": [
            {
              "description": "Date in YYYY-MM format",
              "pattern": "^\\d{4}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "expires": {
          "anyOf": [
            {
              "description": "Date in YYYY-MM format",
              "pattern": "^\\d{4}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires"
        },
        "credential_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Id"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "display": {
          "default": true,
          "title": "Display",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "Certification",
      "type": "object"
    },
    "Education": {
