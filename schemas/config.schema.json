    "Publication": {
      "description": "Publication or speaking engagement record.\n\nStores publication and speaking engagement information for resume\nrendering with support for type classification and display control.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "conference",
            "article",
            "whitepaper",
            "book",
            "podcast",
            "webinar"
          ],
          "title": "Type",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        },
        "date": {
          "description": "Date in YYYY-MM format",
          "pattern": "^\\d{4}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "display": {
