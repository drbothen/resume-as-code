          "title": "Exclude",
          "type": "array"
        },
        "prioritize": {
          "items": {
            "type": "string"
          },
          "title": "Prioritize",
          "type": "array"
        }
      },
      "title": "SkillsConfig",
      "type": "object"
    }
  },
