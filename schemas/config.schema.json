        },
        "gpa": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpa"
        },
        "display": {
          "default": true,
          "title": "Display",
          "type": "boolean"
        }
